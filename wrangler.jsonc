{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pr-review-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.gggodlin.com", "custom_domain": true }],
  "vars": {
    "BILLING_MODE": "disabled"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "pr-review-cloud-db" }]
}
